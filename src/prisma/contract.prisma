// use prisma-next

enum Role {
  USER
  ASSISTANT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Thread {
  id        Int @id @default(autoincrement())
  title     String @unique
  user_id   Int
  createdAt TimestamptzString @default(now())
}

model Message {
  id        String      @id @default(uuid(7))
  thread_id Int
  content   String
  role      Role
  createdAt TimestamptzString @default(now())
}
